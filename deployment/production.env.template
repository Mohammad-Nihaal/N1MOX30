# ============================================================
# N1MOX30 PRODUCTION ENVIRONMENT
# ============================================================
#
# NEVER commit actual values from this file.
# Configure these through the hosting provider's encrypted
# environment-variable system.
#

ENVIRONMENT=production

APP_NAME=N1MOX30
APP_VERSION=0.1.0

# Production PostgreSQL connection supplied by Render
DATABASE_URL=

# Generate a unique long random production secret.
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend production URL
FRONTEND_URL=https://nimox.com

# CORS
CORS_ORIGINS=https://nimox.com,https://www.nimox.com

# ============================================================
# AI PROVIDERS
# ============================================================

AI_PROVIDER=auto
AI_PRIMARY_PROVIDER=bedrock
AI_FALLBACK_PROVIDER=openclaw
AI_ENABLE_DEMO_FALLBACK=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
BEDROCK_ENABLED=true

OPENCLAW_ENABLED=false
OPENCLAW_COMMAND=openclaw
OPENCLAW_MODEL=omniroute/auto

# ============================================================
# BYOK
# ============================================================

N1MOX_BYOK_ENCRYPTION_KEY=

# ============================================================
# GOOGLE / YOUTUBE
# ============================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.nimox.com/oauth/youtube/callback
YOUTUBE_REDIRECT_URI=https://api.nimox.com/oauth/youtube/callback

# ============================================================
# RAZORPAY
# ============================================================

PAYMENT_PROVIDER=razorpay

N1MOX_RAZORPAY_LIVE=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ============================================================
# REAL YOUTUBE PUBLISHING
# ============================================================

N1MOX_ALLOW_REAL_PUBLISH=false

# ============================================================
# PRODUCTION SECURITY
# ============================================================

DEBUG=false
