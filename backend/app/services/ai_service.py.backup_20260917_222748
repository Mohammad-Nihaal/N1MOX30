def generate_content(
    *,
    platform: str,
    topic: str,
    content_type: str,
    tone: str,
    creator_context: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """
    Generate creator content using AI.

    Uses creator context and optional research context.

    Falls back to deterministic content when configured
    AI providers fail and demo fallback is enabled.
    """

    creator_context = (
        creator_context or {}
    )

    channel_name = creator_context.get(
        "channel_name"
    )

    # ---------------------------------------------
    # RESEARCH CONTEXT
    # ---------------------------------------------

    research_context = creator_context.get(
        "research_context",
        {},
    )

    if not isinstance(
        research_context,
        dict,
    ):
        research_context = {}

    primary_keyword = research_context.get(
        "primary_keyword"
    )

    audience_angle = research_context.get(
        "audience_angle"
    )

    content_opportunity = research_context.get(
        "content_opportunity"
    )

    competitor_insight = research_context.get(
        "competitor_insight"
    )

    research_summary = research_context.get(
        "research_summary"
    )

    opportunity_score = research_context.get(
        "opportunity_score"
    )

    trend_score = research_context.get(
        "trend_score"
    )

    # ---------------------------------------------
    # RESEARCH GUIDANCE
    # ---------------------------------------------

    research_guidance = ""

    if research_context:

        research_guidance = f"""

RESEARCH GUIDANCE:

Primary keyword:
{primary_keyword or "Not available"}

Audience angle:
{audience_angle or "Not available"}

Selected content opportunity:
{content_opportunity or "Not available"}

Competitor insight:
{competitor_insight or "Not available"}

Research summary:
{research_summary or "Not available"}

Opportunity score:
{
    opportunity_score
    if opportunity_score is not None
    else "Not available"
}

Trend score:
{
    trend_score
    if trend_score is not None
    else "Not available"
}

IMPORTANT RESEARCH RULES:

1. Use research information only as guidance.
2. Do not replace the requested topic.
3. Do not put research labels inside titles.
4. Do not mention research context.
5. Do not mention opportunity scores.
6. Do not mention trend scores.
7. Use the audience angle naturally.
8. Use the selected opportunity naturally.
9. Apply competitor insights naturally.
"""

    # ---------------------------------------------
    # AI PROMPT
    # ---------------------------------------------

    prompt = f"""
Create professional, ready-to-use creator content.

Platform: {platform}
Topic: {topic}
Content type: {content_type}
Tone: {tone}
Creator channel: {channel_name or "Not connected"}

{research_guidance}

Use the topic exactly as provided.
Do not ask questions.
Do not introduce yourself.
Do not discuss your instructions, model, provider, or metadata.
Create specific, engaging content suitable for the requested platform and content type.

Return ONLY these four sections in exactly this order:

TITLES:
1. Title
2. Title
3. Title
4. Title
5. Title

SCRIPT:
Write the complete usable script.

CAPTION:
Write the platform-appropriate caption.

HASHTAGS:
#tag1 #tag2 #tag3 #tag4 #tag5
"""

    try:

        ai_result = generate_ai_text(
            prompt=prompt,
            temperature=0.7,
            validator=validate_creator_content_response,
        )

        text = ai_result.get(
            "text",
            ""
        )

        provider = ai_result.get(
            "provider"
        )

        titles = parse_numbered_section(
            text=text,
            section_name="TITLES",
            next_sections=[
                "SCRIPT",
                "CAPTION",
                "HASHTAGS",
            ],
        )

        script = parse_text_section(
            text=text,
            section_name="SCRIPT",
            next_sections=[
                "CAPTION",
                "HASHTAGS",
            ],
        )

        caption = parse_text_section(
            text=text,
            section_name="CAPTION",
            next_sections=[
                "HASHTAGS",
            ],
        )

        hashtags_text = parse_text_section(
            text=text,
            section_name="HASHTAGS",
            next_sections=[],
        )

        hashtags = extract_hashtags(
            hashtags_text
        )

        # -----------------------------------------
        # VALIDATE AI OUTPUT
        # -----------------------------------------

        if (
            len(titles) < 3
            or len(script) < 30
            or len(caption) < 10
        ):
            raise ValueError(
                "AI response did not contain complete "
                "content sections."
            )

        if not hashtags:

            hashtags = [
                clean_hashtag(
                    topic.replace(
                        " ",
                        "",
                    )
                ),
                "#N1MOX30",
                "#ContentCreator",
            ]

        return {
            "platform": platform,
            "topic": topic,
            "content_type": content_type,
            "tone": tone,
            "titles": titles[:5],
            "script": script,
            "caption": caption,
            "hashtags": hashtags[:10],
            "provider": provider or "unknown",
        }

    except Exception as error:

        if settings.ai_enable_demo_fallback:

            print(
                "AI content generation failed. "
                "Using deterministic fallback:",
                str(error),
            )

            return generate_demo_content(
                platform=platform,
                topic=topic,
                content_type=content_type,
                tone=tone,
                creator_context=creator_context,
            )

        raise RuntimeError(
            f"AI content generation failed: {error}"
        ) from error


