def generate_deterministic_youtube_insights(
    analytics_data: dict[str, Any],
) -> str:
    """
    Generate a reliable analytics report without relying
    on an external AI provider.
    """

    views = analytics_data.get(
        "views",
        {},
    )

    followers = analytics_data.get(
        "followers",
        {},
    )

    snapshot_count = analytics_data.get(
        "snapshot_count",
        0,
    )

    latest_views = int(
        views.get("latest", 0) or 0
    )

    latest_followers = int(
        followers.get("latest", 0) or 0
    )

    view_change = int(
        views.get("change", 0) or 0
    )

    follower_change = int(
        followers.get("change", 0) or 0
    )

    view_trend = views.get(
        "trend",
        "stable",
    )

    follower_trend = followers.get(
        "trend",
        "stable",
    )

    if snapshot_count < 2:

        summary = (
            f"The channel currently has "
            f"{latest_views:,} total views and "
            f"{latest_followers:,} subscribers."
        )

        data_status = (
            "Only one analytics snapshot is currently "
            "available, so real growth trends cannot yet "
            "be measured."
        )

        key_insights = [
            (
                f"The current baseline is "
                f"{latest_views:,} views."
            ),
            (
                f"The current baseline is "
                f"{latest_followers:,} subscribers."
            ),
            (
                "A second snapshot is required before "
                "changes over time can be measured."
            ),
        ]

        recommendations = [
            (
                "Create another analytics snapshot after "
                "additional channel activity."
            ),
            (
                "Keep publishing consistently to create "
                "useful historical data."
            ),
            (
                "Use different hooks, titles, and topics "
                "to test what attracts viewers."
            ),
        ]

        priority_action = (
            "Create the next analytics snapshot later so "
            "N1MOX30 can begin measuring real growth."
        )

    else:

        summary = (
            f"The channel currently has "
            f"{latest_views:,} total views and "
            f"{latest_followers:,} subscribers."
        )

        data_status = (
            f"{snapshot_count} analytics snapshots are "
            f"available, allowing N1MOX30 to measure "
            f"changes over the recorded period."
        )

        key_insights = [
            (
                f"Views changed by {view_change:,} "
                f"and the current view trend is "
                f"{view_trend}."
            ),
            (
                f"Subscribers changed by "
                f"{follower_change:,} and the current "
                f"subscriber trend is "
                f"{follower_trend}."
            ),
            (
                "Continue collecting snapshots to make "
                "trend analysis more reliable."
            ),
        ]

        recommendations: list[str] = []

        if view_change <= 0:

            recommendations.append(
                "Test stronger video hooks, titles, and "
                "content topics to improve viewer growth."
            )

        else:

            recommendations.append(
                "Analyze the content published during the "
                "growth period and repeat successful "
                "patterns."
            )

        if follower_change <= 0:

            recommendations.append(
                "Add clearer calls to action that "
                "encourage viewers to subscribe."
            )

        else:

            recommendations.append(
                "Identify which content patterns are "
                "attracting subscribers and create more "
                "similar content."
            )

        recommendations.append(
            "Continue recording analytics snapshots to "
            "improve trend accuracy."
        )

        priority_action = (
            "Review your strongest content patterns and "
            "use them to guide your next content plan."
        )

    return (
        "SUMMARY:\n"
        f"{summary}\n\n"
        "DATA STATUS:\n"
        f"{data_status}\n\n"
        "KEY INSIGHTS:\n"
        f"- {key_insights[0]}\n"
        f"- {key_insights[1]}\n"
        f"- {key_insights[2]}\n\n"
        "GROWTH RECOMMENDATIONS:\n"
        f"- {recommendations[0]}\n"
        f"- {recommendations[1]}\n"
        f"- {recommendations[2]}\n\n"
        "PRIORITY ACTION:\n"
        f"{priority_action}"
