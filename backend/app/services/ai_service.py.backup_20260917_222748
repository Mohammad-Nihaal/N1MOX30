def generate_ai_text(
    *,
    prompt: str,
    temperature: float = 0.7,
    validator: Any | None = None,
) -> dict[str, Any]:
    """
    Generate text using the configured AI provider.

    Returns both:
    - cleaned AI text
    - provider name

    Provider routing and failover are handled by
    AIProviderRouter.
    """

    result = ai_provider_router.generate(
        prompt=prompt,
        temperature=temperature,
        validator=validator,
    )

    text = result.get(
        "text",
        "",
    )

    provider = result.get(
        "provider"
    )

    cleaned = clean_ai_response(
        text
    )

    if not cleaned:
        raise RuntimeError(
            "AI provider returned an empty response."
        )

    return {
        "text": cleaned,
        "provider": provider,
        "attempted_providers": result.get("attempted_providers", [provider] if provider else []),
        "fallback_used": bool(result.get("fallback_used", False)),
    }


