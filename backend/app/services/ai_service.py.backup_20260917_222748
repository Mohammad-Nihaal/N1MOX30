def parse_text_section(
    *,
    text: str,
    section_name: str,
    next_sections: list[str],
) -> str:
    """
    Extract a named section from structured AI text.
    """

    escaped_section = re.escape(
        section_name
    )

    if next_sections:

        next_pattern = "|".join(
            re.escape(section)
            for section in next_sections
        )

        pattern = (
            rf"{escaped_section}\s*:\s*"
            rf"(.*?)"
            rf"(?=\n\s*(?:{next_pattern})\s*:|\Z)"
        )

    else:

        pattern = (
            rf"{escaped_section}\s*:\s*"
            rf"(.*)"
        )

    match = re.search(
        pattern,
        text,
        flags=re.IGNORECASE | re.DOTALL,
    )

    if not match:
        return ""

    return match.group(
        1
    ).strip()


def parse_numbered_section(
    *,
    text: str,
    section_name: str,
    next_sections: list[str],
) -> list[str]:
    """
    Extract numbered list items from an AI section.
    """

    section = parse_text_section(
        text=text,
        section_name=section_name,
        next_sections=next_sections,
    )

    if not section:
        return []

    items: list[str] = []

    for line in section.splitlines():

        line = line.strip()

        if not line:
            continue

        line = re.sub(
            r"^\s*(?:\d+[\.\)\-:]|[-*â€¢])\s*",
            "",
            line,
        )

        line = line.strip(
            " -"
        )

        if line:
            items.append(
                line
            )

    return items


def validate_creator_content_response(text: str) -> bool:
    """
    Validate the structured response required by
    N1MOX30 creator content generation.

    This validator is intentionally independent of the
    provider so the AI router can use it for failover.
    """

    if not text or not text.strip():
        return False

    titles = parse_numbered_section(
        text=text,
        section_name="TITLES",
        next_sections=[
            "SCRIPT",
            "CAPTION",
            "HASHTAGS",
        ],
    )

    script = parse_text_section(
        text=text,
        section_name="SCRIPT",
        next_sections=[
            "CAPTION",
            "HASHTAGS",
        ],
    )

    caption = parse_text_section(
        text=text,
        section_name="CAPTION",
        next_sections=[
            "HASHTAGS",
        ],
    )

    hashtags_text = parse_text_section(
        text=text,
        section_name="HASHTAGS",
        next_sections=[],
    )

    hashtags = extract_hashtags(
        hashtags_text
    )

    return bool(
        len(titles) >= 3
        and len(script) >= 30
        and len(caption) >= 10
        and hashtags
    )

def extract_hashtags(
    text: str,
) -> list[str]:
    """
    Extract unique hashtags from AI output.
    """

    hashtags = re.findall(
        r"#[A-Za-z0-9_]+",
        text,
    )

    unique_hashtags: list[str] = []

    for hashtag in hashtags:

        if hashtag not in unique_hashtags:
            unique_hashtags.append(
                hashtag
            )

    return unique_hashtags


