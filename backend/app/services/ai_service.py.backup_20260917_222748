def generate_demo_content(
    *,
    platform: str,
    topic: str,
    content_type: str,
    tone: str,
    creator_context: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """
    Generate deterministic fallback content.

    Research context improves the generated content
    when an external AI provider is unavailable.
    """

    creator_context = (
        creator_context or {}
    )

    channel_name = creator_context.get(
        "channel_name"
    )

    research_context = creator_context.get(
        "research_context",
        {},
    )

    if not isinstance(
        research_context,
        dict,
    ):
        research_context = {}

    primary_keyword = research_context.get(
        "primary_keyword"
    )

    audience_angle = research_context.get(
        "audience_angle"
    )

    content_opportunity = research_context.get(
        "content_opportunity"
    )

    competitor_insight = research_context.get(
        "competitor_insight"
    )

    topic_clean = topic.strip()

    title_topic = re.sub(
        r"\s+",
        " ",
        topic_clean,
    )

    creator_prefix = ""

    if channel_name:

        creator_prefix = (
            f"This content is prepared for "
            f"{channel_name}.\n\n"
        )

    # ---------------------------------------------
    # TITLES
    # ---------------------------------------------

    titles = [
        f"The Truth About {title_topic}",
        f"Why {title_topic} Is Getting Attention",
        f"What You Need to Know About {title_topic}",
        f"5 Things About {title_topic} You Should Know",
        f"The Most Interesting Side of {title_topic}",
    ]

    if audience_angle:

        titles[0] = (
            f"{title_topic}: What You Need to Know"
        )

    if content_opportunity:

        titles[1] = (
            f"Why {title_topic} Is Worth Watching"
        )

    # ---------------------------------------------
    # RESEARCH GUIDANCE
    # ---------------------------------------------

    research_points: list[str] = []

    if primary_keyword:

        research_points.append(
            f"Focus on the key topic angle: "
            f"{primary_keyword}."
        )

    if audience_angle:

        research_points.append(
            f"Make the content relevant to this "
            f"audience angle: {audience_angle}."
        )

    if content_opportunity:

        research_points.append(
            f"Shape the content around this "
            f"opportunity: {content_opportunity}."
        )

    if competitor_insight:

        research_points.append(
            f"Apply this competitive improvement: "
            f"{competitor_insight}"
        )

    research_guidance = ""

    if research_points:

        research_guidance = (
            "\n\n"
            + "\n".join(
                f"- {point}"
                for point in research_points
            )
        )

    # ---------------------------------------------
    # SCRIPT
    # ---------------------------------------------

    hook = (
        f"Today we are exploring "
        f"{topic_clean}."
    )

    if audience_angle:

        hook = (
            f"{topic_clean}: "
            f"{audience_angle}"
        )

    script = (
        f"{creator_prefix}"
        f"{hook}\n\n"
        f"Here is the key point: there is more to "
        f"{topic_clean} than most people realize.\n\n"
        f"In this {content_type}, we focus on a clear "
        f"and engaging angle so viewers immediately "
        f"understand why this topic matters.\n\n"
        f"Start strong, deliver the most interesting "
        f"points quickly, and keep the pacing aligned "
        f"with a {tone} style."
        f"{research_guidance}\n\n"
        f"Finish with a memorable takeaway and give "
        f"viewers a clear reason to comment, share, "
        f"and follow for more content."
    )

    # ---------------------------------------------
    # CAPTION
    # ---------------------------------------------

    caption_angle = (
        audience_angle
        or content_opportunity
        or "a focused and engaging perspective"
    )

    caption = (
        f"{topic_clean} is worth talking about.\n\n"
        f"This {content_type} explores "
        f"{caption_angle}.\n\n"
        f"What is your opinion? "
        f"Share it in the comments."
    )

    # ---------------------------------------------
    # HASHTAGS
    # ---------------------------------------------

    hashtags: list[str] = []

    topic_hashtag = clean_hashtag(
        topic_clean.replace(
            " ",
            "",
        )
    )

    hashtags.append(
        topic_hashtag
    )

    if primary_keyword:

        keyword_hashtag = clean_hashtag(
            str(primary_keyword).replace(
                " ",
                "",
            )
        )

        if keyword_hashtag not in hashtags:

            hashtags.append(
                keyword_hashtag
            )

    hashtags.extend(
        [
            "#N1MOX30",
            f"#{platform.capitalize()}",
            "#ContentCreator",
            "#AI",
        ]
    )

    unique_hashtags: list[str] = []

    for hashtag in hashtags:

        if hashtag not in unique_hashtags:

            unique_hashtags.append(
                hashtag
            )

    return {
        "platform": platform,
        "topic": topic_clean,
        "content_type": content_type,
        "tone": tone,
        "titles": titles[:5],
        "script": script,
        "caption": caption,
        "hashtags": unique_hashtags[:10],
        "provider": "deterministic_fallback",
    }


