# =============================
# N1MOX30 APPLICATION
# =============================
APP_NAME=N1MOX30
APP_VERSION=1.0.0
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# =============================
# DATABASE
# =============================
DATABASE_URL=sqlite:///./n1mox30.db

# =============================
# SECURITY
# Change SECRET_KEY before production.
# =============================
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =============================
# AI ROUTING
# demo = local deterministic fallback
# auto = primary -> fallback -> demo
# =============================
AI_PROVIDER=auto
AI_PRIMARY_PROVIDER=openclaw
AI_FALLBACK_PROVIDER=openclaw
AI_ENABLE_DEMO_FALLBACK=true
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=1

# =============================
# OPENAI (optional)
# =============================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# =============================
# GEMINI (optional)
# =============================
GEMINI_API_KEY=

# =============================
# AWS BEDROCK (optional)
# =============================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
AWS_PROFILE=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_ENABLED=true

# =============================
# OPENCLAW / OMNIROUTE
# =============================
OPENCLAW_ENABLED=true
OPENCLAW_COMMAND=openclaw
OPENCLAW_MODEL=omniroute/auto
OPENCLAW_TIMEOUT_SECONDS=120

# =============================
# YOUTUBE / GOOGLE OAUTH (optional until connected)
# =============================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/oauth/youtube/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/oauth/youtube/callback

# Meta / Instagram
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:8000/oauth/instagram/callback
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/oauth/instagram/callback
INSTAGRAM_GRAPH_VERSION=v24.0

# X
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8000/oauth/x/callback

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8000/oauth/tiktok/callback

# Public media hosting for Instagram/TikTok URL-based delivery
PUBLIC_MEDIA_BASE_URL=
MOBILE_DEEP_LINK=n1mox30://

# Production voice
VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2
VOICE_OUTPUT_DIR=storage/voice
