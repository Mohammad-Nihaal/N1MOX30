# ============================================================
# N1MOX30 PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================
# NEVER put real production secrets into this file.

APP_ENV=production
DEBUG=false

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

AI_PROVIDER=demo
OPENAI_API_KEY=

# Database
DATABASE_URL=

# YouTube / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Real publishing remains OFF until final manual verification.
N1MOX_ALLOW_REAL_PUBLISH=false

# Frontend
FRONTEND_URL=

# Analytics
ANALYTICS_ENABLED=false

# BYOK encryption key - generate a long random secret before production
N1MOX_BYOK_ENCRYPTION_KEY=


# N1MOX30 Payments
N1MOX_PAYMENT_PROVIDER=razorpay
N1MOX_RAZORPAY_LIVE=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RAZORPAY_CREATOR_AMOUNT_INR=1599
RAZORPAY_PRO_AMOUNT_INR=4099
RAZORPAY_STUDIO_AMOUNT_INR=10999

N1MOX_BILLING_SUCCESS_URL=https://YOUR-DOMAIN/app/billing?success=1
N1MOX_BILLING_CANCEL_URL=https://YOUR-DOMAIN/app/billing?cancelled=1

